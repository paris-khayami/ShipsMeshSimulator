<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The name of the private folder on this computer that holds the API key. -->
    <UserSecretsId>ships-mesh-simulator</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include the recording when the app is published to a server. -->
    <Content Include="recordings\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
